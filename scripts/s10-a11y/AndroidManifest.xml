<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.citoviso.a11y">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
  <application android:label="Citoviso A11y">
    <service android:name=".CitA11yService" android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y"/>
    </service>
  </application>
</manifest>
