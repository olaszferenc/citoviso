#!/usr/bin/env bash
# Versioned git pre-commit gate (git config core.hooksPath hooks). Physical doctrine
# enforcement — a commit cannot carry: (1) an unwrapped customer-facing Hungarian literal
# (§B.18 i18n doctrine), (2) a stale i18n catalog (new strings would ship untranslated),
# (3) a design-token doctrine break, (4) a PRICED module with no owner-settable config
# (ADR-0044). Fast checks only (no tsc here).
set -e
cd "$(git rev-parse --show-toplevel)"
# scripts/land.sh runs this suite AFTER rebase with nothing staged — there the diff being
# landed is origin/main...HEAD, and the slow, diff-scoped gates must key off THAT, or they
# silently skip on an empty staged set. LAND_RANGE switches the scoping; unset = commit mode.
changed_files() {
  if [ -n "${LAND_RANGE:-}" ]; then git diff --name-only "$LAND_RANGE"; else git diff --cached --name-only; fi
}
# ⛔ SYMLINK-TILALOM (2026-08-24, valós kár): a per-worktree `assets/Temp` symlink
# bekerült egy commitba, és a fő fába landolva FELÜLÍRTA az ugyanott élő VALÓS
# mappát — a tulaj bedobó-mappájának tartalma elveszett. A .gitignore `assets/Temp/`
# mintája nem fogta, mert a záró perjel csak könyvtárra illeszkedik, a symlink pedig
# fájl. Ez a kapu a hibaosztályt zárja: symlink SOHA nem mehet a repóba.
sym=$(git diff --cached --diff-filter=ACMR --raw | awk '$2 == "120000" { print $NF }')
if [ -n "$sym" ]; then
  echo "⛔ SYMLINK a commitban — a repóba symlink nem mehet (felülírhatja a másik fa valós mappáját):"
  echo "$sym" | sed 's/^/   · /'
  echo "   Vedd ki: git rm --cached <útvonal> ; és tedd .gitignore-ba (ZÁRÓ PERJEL NÉLKÜL)."
  exit 1
fi
echo "[pre-commit] i18n-lint (§B.18)…"
npx tsx scripts/i18n-lint.mts
echo "[pre-commit] i18n-katalógus frissesség…"
npx tsx scripts/extract-i18n.mts --check
# ADR-0067 ②: the STRUCTURAL check. i18n-lint hunts Hungarian ACCENTS and is blind
# to unaccented Hungarian ("1 db" shipped to a Polish tenant exactly that way); this
# renders the real surfaces in a marked pseudo-locale, where anything unmarked never
# went through T() — accents or not.
if [ -f scripts/i18n-pseudo-check.mts ]; then
  echo "[pre-commit] i18n-pszeudo-nyelv (strukturális)…"
  npx tsx scripts/i18n-pseudo-check.mts
fi
if [ -f scripts/design-token-lint.mts ]; then
  echo "[pre-commit] design-token-lint…"
  npx tsx scripts/design-token-lint.mts
fi
if [ -f scripts/module-config-lint.mts ]; then
  echo "[pre-commit] module-config-lint (ADR-0044)…"
  npx tsx scripts/module-config-lint.mts
fi
# The tracked outreach link gained a readable slug (/p/<slug>/<token>). Links we
# ALREADY SENT use the bare /p/<token> shape and must never stop resolving — a
# dead link in a cold mail is a lead lost in silence, with nothing in any log.
if [ -f scripts/check-prospect-path.mts ]; then
  echo "[pre-commit] check-prospect-path (régi + új /p/ linkalak)…"
  npx tsx scripts/check-prospect-path.mts
fi
# A pilot-BCC (EMAIL_BCC) minden SAJÁT levelünkről másolatot küld a tulajnak — de a
# közös adapter viszi a tenant VENDÉGEINEK szóló leveleket is (foglalás-visszaigazolás,
# vélemény), ahol a tenant az adatkezelő. Egy elcsúszott 'audience' némán a mi
# postafiókunkba terelné a vendégek személyes adatait. Öntesztelt: --self-test.
if [ -f scripts/check-email-bcc.mts ]; then
  echo "[pre-commit] check-email-bcc (a pilot-másolat nem vihet vendég-adatot)…"
  npx tsx scripts/check-email-bcc.mts
fi
# ADR-0045 §J: KB gate — entry lint (frontmatter, anchors, non-placeholder body,
# image refs, **„label”** drift against the view sources) AND coverage (every
# data-kb-anchor in the admin views has an entry, every entry is reachable, the
# five admin tabs are mandatory). Armed with the UI-anchor slice (ADR-0045 ②).
if [ -f scripts/kb-check.mts ]; then
  echo "[pre-commit] kb-check --coverage (ADR-0045: tudásbázis-kapu)…"
  npx tsx scripts/kb-check.mts --coverage
fi
# The one that matters for modules: a SETTING must reach the rendered page. The lint
# above only proves a settings screen exists — that was green for days while nothing
# the tenant typed showed up on the site.
if [ -f scripts/module-render-check.mts ]; then
  echo "[pre-commit] module-render-check (ADR-0044: beállítás → oldal)…"
  npx tsx scripts/module-render-check.mts
fi
# ADR-0059: one content type appears ONCE, inside the template's native section —
# module data weaves in, the shared block carries only the measured leftover; the
# mock's sample rooms wear real photos and its booking slot is a clickable demo.
# Render-based (no browser), with a red self-test on the dup detector.
if [ -f scripts/native-content-check.mts ]; then
  echo "[pre-commit] native-content-check (ADR-0059: egy tartalomtípus egyszer)…"
  npx tsx scripts/native-content-check.mts
fi
# A kiemelés a VENDÉGNEK szóljon (tulaj, 2026-08-24): a vízió-brief a fotó
# FELÜLETEIT írja le, ha nem állítjuk meg — „sárga homlokzat", „bézs csempés
# fürdőszoba", „kék-zöld ágynemű". A prompt kéri, a szűrő kikényszeríti; a fixture
# minden sora VALÓBAN kiment egy mockba. Offline, gyors, önteszttel.
if [ -f scripts/highlight-value-check.mts ]; then
  echo "[pre-commit] highlight-value-check (a kiemelés vendég-érték legyen)…"
  npx tsx scripts/highlight-value-check.mts
fi
# NYELVI őr (tulaj, 2026-08-23): a vendégnek szóló szöveg egységesen MAGÁZÓ,
# természetes magyar — se tegezés, se többes-tegezés, se a `unit` 1:1 fordítása
# („Egységeink"), se erőltetett fordulat („Válassz sarkot magadnak"). Renderelt
# oldalon mér, mind a 16 sablonon, piros önteszttel.
if [ -f scripts/hu-voice-check.mts ]; then
  echo "[pre-commit] hu-voice-check (vendég-oldali magyar hangnem)…"
  npx tsx scripts/hu-voice-check.mts
fi
# ADR-0056: a legal link must resolve to a route that is really served, on BOTH
# servers, without a login. The bug this catches shipped for real — the outreach
# mock footer pointed at /adatvedelem while only /privacy existed, so every cold
# mail carried a dead legal link. Offline, no DB, fast.
if [ -f scripts/legal-check.mts ]; then
  echo "[pre-commit] legal-check (ADR-0056: jogi dokumentum-réteg)…"
  npx tsx scripts/legal-check.mts
fi
# ADR-0044/d: a unit subpage must carry the SAME style as the homepage (§I delivery)
# and must never be thin content. Pure render comparison, no browser — fast.
if [ -f scripts/unit-subpage-check.mts ]; then
  echo "[pre-commit] unit-subpage-check (aloldal stílus + thin content)…"
  npx tsx scripts/unit-subpage-check.mts
fi
# Template picker gate (2026-08-21): the card grid must SELECT when clicked, not just zoom.
# Behaviour check in a real browser (~7s), so only when the picker's code is staged.
if [ -f scripts/template-picker-check.mts ] && \
   changed_files | grep -qE '^src/console/views\.ts|^public/assets/ui/citui-console\.css'; then
  echo "[pre-commit] template-picker-check (ADR-0027: a kártya választ)…"
  npx tsx scripts/template-picker-check.mts
fi
# 0032: the paid order must become a partner with ALL the buyer's billing recipients,
# and doing it twice must change nothing (a re-delivered webhook / late callback
# re-drives the same path). Builds its own throwaway DB (~10s), so it is scoped to
# commits that touch the partner path.
if [ -f scripts/partner-registry-check.mts ] && \
   changed_files | grep -qE '^src/billing/|^src/payment/service\.ts|^migrations/0032'; then
  echo "[pre-commit] partner-registry-check (0032: partner + számlázási címzettek)…"
  npx tsx scripts/partner-registry-check.mts
fi
# PARTNER-UI-SPEC: the partner console must BEHAVE — aging bucket boundaries
# (30/31, 60/61, 90/91) + conservation, payment-habit sign, CSV shape (BOM,
# escaping), tabs that SWITCH when clicked (desktop + 390px, tap size as a
# range), and the role decree (no Előfizetés tab on a pure supplier). Hermetic
# fixtures + a real browser (~15s), so scoped to the partner console files.
# Red self-test: `npx tsx scripts/partner-ui-check.mts --self-test`.
if [ -f scripts/partner-ui-check.mts ] && \
   changed_files | grep -qE '^src/console/partner(Data|Views)\.ts$|^src/console/server\.ts$'; then
  echo "[pre-commit] partner-ui-check (partner-felület viselkedés-kapu)…"
  npx tsx scripts/partner-ui-check.mts
fi
# 0033: a fizetős modul CSAK fizetés után kapcsolhat be. A rés a ROUTE-ban volt
# (a posztolt lista nyersen ment a setTenantModules-nak), ezért az őr a route
# alakját ÉS a viselkedést is méri. Saját eldobható DB-t épít.
if [ -f scripts/module-upsell-check.mts ] && \
   changed_files | grep -qE '^src/tenant/module|^src/server/public\.ts|^src/payment/service\.ts|^src/console/(views|server)\.ts|^migrations/0033'; then
  echo "[pre-commit] module-upsell-check (0033: modul-upsell fizetési kapu)…"
  npx tsx scripts/module-upsell-check.mts
fi
# ADR-0046: moderation has to HOLD. Runs against the real DB on a throwaway fixture, so
# it is scoped to commits that actually touch the review path — the dangerous direction
# is a pending/rejected review reaching the page, and a Google badge shown without cover.
if [ -f scripts/review-flow-check.mts ] && \
   changed_files | grep -qE '^src/reviews/|^src/tenant/editor\.ts|^src/engine/moduleSections\.ts|^migrations/0027'; then
  echo "[pre-commit] review-flow-check (ADR-0046: moderáció + Google-jelvény kapui)…"
  npx tsx scripts/review-flow-check.mts
fi
# ADR-0047: a paid module must land in a NAMED PLACE at full width — in the rendered page
# AND in what the cold-outreach lead sees. Both shipped broken while every other guard was
# green, because none of them asked "where, and how wide?". Browser-driven (~60s), so scoped
# to commits that touch the engine's placement or the configurator.
if [ -f scripts/module-slot-check.mts ] && \
   changed_files | grep -qE '^src/engine/(templates/|render\.ts|moduleSections\.ts)'; then
  echo "[pre-commit] module-slot-check (ADR-0047: modul a helyén, teljes szélességben)…"
  npx tsx scripts/module-slot-check.mts
fi
if [ -f scripts/configurator-placement-check.mts ] && \
   changed_files | grep -qE '^assets/runtime/cit-configurator|^src/generator/configurator\.ts|^src/engine/(templates/|render\.ts|moduleSections\.ts)'; then
  echo "[pre-commit] configurator-placement-check (ADR-0047: a lead a teljes csomagot látja)…"
  npx tsx scripts/configurator-placement-check.mts
fi
# Portal photos must be the PROPERTY's photos (2026-08-21). A listing page also carries
# flags, ad banners, article thumbnails and map graphics; two of eight leads would have
# rendered a misattributed hero (§B.17). Real url+size cases, hermetic, no network.
if [ -f scripts/photo-quality-check.mts ]; then
  echo "[pre-commit] photo-quality-check (§B.17: a fotó a SZÁLLÁSÉ)…"
  npx tsx scripts/photo-quality-check.mts
fi
# Portal photos must REACH the renderer (2026-08-21). The collecting layer was green for
# hours while nothing outside src/scraper/ read portalProfiles, and the engine stamped every
# photo "places" — a lie the §A live gate then acted on. Hermetic, no network.
if [ -f scripts/portal-photo-check.mts ]; then
  echo "[pre-commit] portal-photo-check (portál-fotó → renderelő, §A jogállás)…"
  npx tsx scripts/portal-photo-check.mts
fi
# §A.2: the watermark flag must SURVIVE the owner's photo edits (2026-08-21). Reorder,
# caption and unit-assign each rebuilt the photo array by hand and dropped it — and since
# overrides replace the array wholesale, a watermarked photo would then have gone live.
# Real DB fixture, so scoped to the photo-edit path.
if [ -f scripts/photo-rights-edit-check.mts ] && \
   changed_files | grep -qE '^src/tenant/editor\.ts|^src/engine/photoPolicy\.ts'; then
  echo "[pre-commit] photo-rights-edit-check (§A.2: a vízjel-jelölés túléli a szerkesztést)…"
  npx tsx scripts/photo-rights-edit-check.mts
fi
# A lead carrying portal data must be PERSISTABLE (2026-08-21). A bare URL in the JSONB
# matched_entity column rolled back a whole 554-lead run; the type said `string | null`,
# so tsc saw nothing. Needs the local DB, so it runs only when persist code is staged.
if [ -f scripts/persist-portal-check.mts ] && \
   changed_files | grep -qE '^src/scraper/persist\.ts|^src/db/schema\.ts'; then
  echo "[pre-commit] persist-portal-check (portál-adat → DB round-trip)…"
  npx tsx scripts/persist-portal-check.mts
fi
# Mobile sticky-dock gate (2026-08-21): renders every template/archetype at phone width and
# fails if a booking dock covers the viewport. It's a headless render (~10s), so run it ONLY
# when engine layout/render code is actually staged — normal commits stay fast.
if [ -f scripts/mobile-sticky-check.mts ] && \
   changed_files | grep -qE '^src/engine/(templates/|archetypes\.ts|render\.ts)|^src/generator/runtime\.ts'; then
  echo "[pre-commit] mobile-sticky-check (foglaló-dokk mobil-takarás)…"
  npx tsx scripts/mobile-sticky-check.mts
fi
# Configurator sell-gate (2026-08-21): the itemised switches must be open on panel
# open and the monthly total must stay on screen AND move with every flip — measured
# in a real browser at desktop + phone width. Headless render (~15s), so it runs only
# when the configurator itself is staged.
if [ -f scripts/configurator-price-check.mts ] && \
   changed_files | grep -qE '^assets/runtime/cit-configurator\.(js|css)$|^src/generator/configurator\.ts$|^src/modules\.ts$|^src/pricing\.ts$'; then
  echo "[pre-commit] configurator-price-check (nyitott lista + követhető ár)…"
  npx tsx scripts/configurator-price-check.mts
fi

# BILLING GATE (0029): an order must never be placed without a usable invoice
# buyer. Guards both halves — validateBuyer() as the server truth, and the
# checkout step in a real browser at 390px (the fields shown must match the
# declared buyer type). Runs when anything on that chain is staged.
if [ -f scripts/billing-checkout-check.mts ] && \
   changed_files | grep -qE '^src/billing/|^src/invoicing/|^src/payment/service\.ts$|^src/legal\.ts$|^assets/runtime/cit-configurator\.(js|css)$|^src/generator/configurator\.ts$|^src/console/server\.ts$'; then
  echo "[pre-commit] billing-checkout-check (0029: nincs order számlázható vevő nélkül)…"
  npx tsx scripts/billing-checkout-check.mts
fi
# SÉMA-DRIFT (0031): a schema.ts a migrációk fordítási idejű tükre, de a Kysely tábla-típusok
# puszta deklarációk — egy elgépelt oszlopnév ZÖLD tsc mellett is átcsúszik, és csak futásidőben
# robban. Élesben megtörtént. Helyi DB kell hozzá, ezért csak séma-érintő commitnál fut.
if [ -f scripts/schema-drift-check.mts ] && \
   changed_files | grep -qE '^migrations/|^src/db/schema\.ts$'; then
  echo "[pre-commit] schema-drift-check (DB-oszlopok ↔ Kysely-típusok)…"
  npx tsx scripts/schema-drift-check.mts
fi
echo "[pre-commit] ✅ minden kapu zöld"
