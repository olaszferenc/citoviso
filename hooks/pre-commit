#!/usr/bin/env bash
# Versioned git pre-commit gate (git config core.hooksPath hooks). Physical doctrine
# enforcement — a commit cannot carry: (1) an unwrapped customer-facing Hungarian literal
# (§B.18 i18n doctrine), (2) a stale i18n catalog (new strings would ship untranslated),
# (3) a design-token doctrine break, (4) a PRICED module with no owner-settable config
# (ADR-0044). Fast checks only (no tsc here).
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] i18n-lint (§B.18)…"
npx tsx scripts/i18n-lint.mts
echo "[pre-commit] i18n-katalógus frissesség…"
npx tsx scripts/extract-i18n.mts --check
if [ -f scripts/design-token-lint.mts ]; then
  echo "[pre-commit] design-token-lint…"
  npx tsx scripts/design-token-lint.mts
fi
if [ -f scripts/module-config-lint.mts ]; then
  echo "[pre-commit] module-config-lint (ADR-0044)…"
  npx tsx scripts/module-config-lint.mts
fi
# Mobile sticky-dock gate (2026-08-21): renders every template/archetype at phone width and
# fails if a booking dock covers the viewport. It's a headless render (~10s), so run it ONLY
# when engine layout/render code is actually staged — normal commits stay fast.
if [ -f scripts/mobile-sticky-check.mts ] && \
   git diff --cached --name-only | grep -qE '^src/engine/(templates/|archetypes\.ts|render\.ts)|^src/generator/runtime\.ts'; then
  echo "[pre-commit] mobile-sticky-check (foglaló-dokk mobil-takarás)…"
  npx tsx scripts/mobile-sticky-check.mts
fi
echo "[pre-commit] ✅ minden kapu zöld"
