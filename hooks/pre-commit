#!/usr/bin/env bash
# Versioned git pre-commit gate (git config core.hooksPath hooks). Physical doctrine
# enforcement — a commit cannot carry: (1) an unwrapped customer-facing Hungarian literal
# (§B.18 i18n doctrine), (2) a stale i18n catalog (new strings would ship untranslated),
# (3) a design-token doctrine break, (4) a PRICED module with no owner-settable config
# (ADR-0044). Fast checks only (no tsc here).
set -e
cd "$(git rev-parse --show-toplevel)"
# scripts/land.sh runs this suite AFTER rebase with nothing staged — there the diff being
# landed is origin/main...HEAD, and the slow, diff-scoped gates must key off THAT, or they
# silently skip on an empty staged set. LAND_RANGE switches the scoping; unset = commit mode.
changed_files() {
  if [ -n "${LAND_RANGE:-}" ]; then git diff --name-only "$LAND_RANGE"; else git diff --cached --name-only; fi
}
# ⛔⛔ A NÉMA BUKÁS (mérve 2026-09-15, ADR-0171). A kapuk többsége a `>/dev/null`-ra írt, a hook
# pedig `set -e`-vel fut — így egy BUKÓ kapu kimenete NYOMTALANUL eltűnt, és a napló ennyit
# mondott: a kapu fejléc-sora, majd semmi. Ez nem hamis zöld (a bukás bukás, a commit nem jön
# létre), hanem DIAGNOSZTIZÁLHATATLAN bukás — és pont akkor a legdrágább, amikor a legnagyobb a
# baj: három diagnosztikai kört vitt el (a folyamat megölését, majd OOM-ot gyanítottunk, dmesg-et
# olvastunk, tmux-ba menekítettük a commitot), miközben a `hu-machine-form-check` VALÓDI leletet
# talált — egy „a(z)" a felhasználói szövegben. A megtalálása órák, a javítása percek voltak.
#
# A mechanika: a kapu stdout-ja FÁJLBA megy, és CSAK BUKÁSKOR kerül kiírásra.
# ⚠️ A stderr SZÁNDÉKOSAN átfolyik, ahogy eddig is (a `>/dev/null` sem fogta) — így a SIKERES
#    futás viselkedése bitre ugyanaz marad, és csak a bukás lesz olvasható. A csendes zöld futás
#    a `>/dev/null` jogos szándéka volt; azt megtartjuk, csak a bukást nem nyeljük el.
# ⚠️ A hívás alakja SZÁNDÉKOSAN UTÓTAG (`… >"$GATE_LOG" || gate_failed`), nem burkoló előtag:
#    a `guard-wiring-check` (ADR-0152) a SOR ELEJÉRE horgonyozva ismeri fel a bekötést
#    (`/^\s*(?:npx tsx|node)\s+scripts\/…/`), egy `run_gate ` előtag tehát a kapuk többségét
#    „bekötetlennek" jelentette volna. Mérve igazolva: a felismert halmaz a transzformáció előtt
#    és után AZONOS.
# A bukó kaput a KÖZVETLENÜL előtte álló `[pre-commit] …` sor nevezi meg, a kimenete pedig rögtön
# utána jön — ezért nem kell a nevet minden hívásba külön beírni.
# Őr, ami ezt életben tartja: `scripts/gate-output-check.mts` (szerkezet + éles viselkedés).
GATE_LOG="$(mktemp -t cit-gate-XXXXXX)"
trap 'rm -f "$GATE_LOG"' EXIT
gate_failed() {
  rc=$?
  echo >&2
  echo "⛔ EZ A KAPU ELBUKOTT (kilépési kód: $rc). A kimenete, amit eddig a >/dev/null elnyelt:" >&2
  echo "──────────────────────────────────────────────────────────────────────" >&2
  cat "$GATE_LOG" >&2
  echo "──────────────────────────────────────────────────────────────────────" >&2
  # ⚠️ PARK-GYANÚ. A hook 166 kaput hív, és ezek közül 55 a KÖZÖS dev-DB-t olvassa,
  # amin ~10 worktree osztozik — egy idegen session teszt-maradéka tehát eltörheti
  # egy kapu ELŐFELTÉTELÉT, és a piros ilyenkor NEM a commitolni készült diffről szól.
  # Mérve 2026-09-22: egy árva `_amdedup_…` lead HAT land-kísérletet blokkolt,
  # miközben a kód hibátlan volt — és semmi nem súgta meg, hol keresse az ember.
  #   ⛔ Csak akkor szólal meg, ha a kapu kimenete ELŐFELTÉTEL-hiányra utal: egy
  # minden bukáshoz odabiggyesztett tanács zajjá válna, és a VALÓDI leleteket is
  # „á, biztos megint a park" reflexbe fullasztaná.
  if grep -qE "ELŐFELTÉTEL|nincs egyetlen|nincs vásárolt|nincs tenant" "$GATE_LOG" 2>/dev/null; then
    echo >&2
    echo "ℹ️  PARK-GYANÚ: ez a kapu ELŐFELTÉTEL-hiányra panaszkodik, nem szabálysértésre." >&2
    echo "   A közös dev-parkot más session is írja. Mielőtt a saját kódodat kezdenéd" >&2
    echo "   keresni, kérdezd meg a parkot:  npx tsx scripts/park-doctor.mts" >&2
  fi
  exit "$rc"
}
# ⏱️ PÁRHUZAMOS KAPU-FUTTATÁS (mérve 2026-09-24; az ADR száma a `scripts/lib/gate-runner.mjs`
# fejlécében). A 4 nagy felületi fájlt érintő
# commit 98 kaput indított EGYMÁS UTÁN (~15 perc, a land ugyanezt még egyszer), egy 8 magos
# gépen egyetlen magot járatva; kapunként ~1,8 s csak az `npx tsx` indulása.
# A MECHANIKA: a kapu-sorok szövege VÁLTOZATLAN (a `guard-wiring-check` és a
# `gate-output-check` a sor elejére horgonyoz). Az `npx`/`node` itt shell-függvény: a kaput
# NEM futtatja, hanem feljegyzi (argv · környezet — a `PAYMENT_GATEWAY=mock` előtaggal együtt —
# · cwd · a pipe-olt stdin · a `[pre-commit] …` felirat · elnémított-e a stdout-ja), és a
# `gate_flush` a hook VÉGÉN a `scripts/lib/gate-runner.mjs`-sel lefuttatja mindet:
#   ① párhuzamosan, Postgres-KÉNYSZERÍTETT csak-olvasó módban — egy kapu sem írhat bele a
#      másik mérésébe; aki írni PRÓBÁLT, annak az ítélete eldobva, és
#   ② sorosan, normál módban fut újra, a többi kapu után, senkivel át nem fedve.
#   Mindkét fázis GÉPI slotban fut (~/.claude/cit-gate-slots, alapból 6 — sessiontől
#   függetlenül ennyi kapu fut egyszerre az egész gépen; ADR a futtató fejlécében).
# Egyetlen kapu sem marad ki és egyik sem változik: a futtató azt dönti el, MIKOR fut, nem azt,
# hogy fut-e. ⚠️ A bukó kaput ugyanaz a `gate_failed` írja ki, mint soros módban.
# Soros mód (a régi viselkedés, hibakereséshez): CIT_GATE_JOBS=1. Őr: `scripts/gate-runner-check.mts`.
CIT_ROOT="$PWD"
if [ "${CIT_GATE_JOBS:-}" = "1" ]; then
  # Serial: run in place, only skip the npm start-up of `npx tsx` (same tsx binary).
  npx() {
    if [ "${1:-}" = "tsx" ] && [ -x "$CIT_ROOT/node_modules/.bin/tsx" ]; then
      shift
      "$CIT_ROOT/node_modules/.bin/tsx" "$@"
    else
      command npx "$@"
    fi
  }
else
  # The hook's own stdin is not the gates' input (git gives a pre-commit hook none): with it
  # closed, `[ -p /dev/stdin ]` below means exactly "this gate is fed by a pipe in the hook".
  exec </dev/null
  GATE_JOBS="$(mktemp -d -t cit-gate-jobs-XXXXXX)"
  # ⛔ A recorded gate that never runs would be a SILENT GREEN. If the hook ends "successfully"
  # without gate_flush (an early `exit 0` added one day), the exit trap turns it into a failure.
  gate_exit() {
    local rc=$?
    rm -f "$GATE_LOG"
    if [ "$rc" -eq 0 ] && [ -z "${GATE_FLUSHED:-}" ] && [ -n "$(ls -A "$GATE_JOBS" 2>/dev/null)" ]; then
      builtin echo "⛔ A hook gate_flush NÉLKÜL ért véget: a feljegyzett kapuk NEM futottak le — ez bukás, nem zöld." >&2
      rm -rf "$GATE_JOBS"
      exit 1
    fi
    rm -rf "$GATE_JOBS"
  }
  trap gate_exit EXIT
  GATE_SEQ=0
  GATE_LABEL=""
  # The gate label (`echo "[pre-commit] …"`) is recorded for the job, and printed by the runner
  # together with the gate's output when it finishes; every other echo is untouched.
  echo() {
    if [ "$#" -eq 1 ] && [ "${1#\[pre-commit\] }" != "$1" ]; then GATE_LABEL="$1"; else builtin echo "$@"; fi
  }
  gate_enqueue() {
    GATE_SEQ=$((GATE_SEQ + 1))
    local j="$GATE_JOBS/$GATE_SEQ.$BASHPID"
    printf '%s\0' "$@" >"$j.argv"
    env -0 >"$j.env"
    builtin printf '%s' "$PWD" >"$j.cwd"
    builtin printf '%s' "$GATE_LABEL" >"$j.label"
    if [ /dev/stdout -ef "$GATE_LOG" ]; then : >"$j.quiet"; fi
    if [ -p /dev/stdin ]; then cat >"$j.stdin"; fi
  }
  npx() { gate_enqueue npx "$@"; }
  node() { gate_enqueue node "$@"; }
fi
gate_flush() {
  [ -n "${GATE_JOBS:-}" ] || return 0
  GATE_FLUSHED=1
  unset -f echo npx node
  local rc=0 key=""
  # Pass-cache key (see gate-runner.mjs): the tree the gates measure + the hash of the gated
  # diff — ONLY when the worktree equals the index and nothing untracked (but the per-worktree
  # symlinks) could be imported. Otherwise empty: nothing is reused, every gate runs.
  if git diff --quiet 2>/dev/null && \
     [ -z "$(git status --porcelain --untracked-files=normal 2>/dev/null | grep '^??' | grep -vE '^\?\? (sites/?|assets/Temp/?)$')" ]; then
    local tree diffsum
    # pipefail: a FAILED `git diff` must not turn into the hash of an empty diff.
    if tree=$(git write-tree 2>/dev/null) && \
       diffsum=$(set -o pipefail; if [ -n "${LAND_RANGE:-}" ]; then git diff --binary "$LAND_RANGE"; else git diff --cached --binary; fi 2>/dev/null | sha256sum); then
      key="$tree ${diffsum%% *}"
    fi
  fi
  CIT_GATE_KEY="$key" command node scripts/lib/gate-runner.mjs "$GATE_JOBS" "$CIT_ROOT" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  [ -f "$GATE_JOBS/FAILED" ] || { echo "⛔ a kapu-futtató maga hibázott (kilépési kód: $rc)" >&2; exit "$rc"; }
  local n i=0 grc label out err
  n=$(wc -l <"$GATE_JOBS/FAILED")
  while IFS=$'\t' read -r grc label out err; do
    i=$((i + 1))
    echo "$(cat "$label")"
    cat "$err" >&2
    cat "$out" >"$GATE_LOG"
    # Every failed gate goes through the SAME gate_failed; all but the last in a subshell,
    # so each is printed and the hook still exits with the last one's code.
    if [ "$i" -lt "$n" ]; then ( (exit "$grc") || gate_failed ) || true; else (exit "$grc") || gate_failed; fi
  done <"$GATE_JOBS/FAILED"
}
# ⛔ SYMLINK-TILALOM (2026-08-24, valós kár): a per-worktree `assets/Temp` symlink
# bekerült egy commitba, és a fő fába landolva FELÜLÍRTA az ugyanott élő VALÓS
# mappát — a tulaj bedobó-mappájának tartalma elveszett. A .gitignore `assets/Temp/`
# mintája nem fogta, mert a záró perjel csak könyvtárra illeszkedik, a symlink pedig
# fájl. Ez a kapu a hibaosztályt zárja: symlink SOHA nem mehet a repóba.
sym=$(git diff --cached --diff-filter=ACMR --raw | awk '$2 == "120000" { print $NF }')
if [ -n "$sym" ]; then
  echo "⛔ SYMLINK a commitban — a repóba symlink nem mehet (felülírhatja a másik fa valós mappáját):"
  echo "$sym" | sed 's/^/   · /'
  echo "   Vedd ki: git rm --cached <útvonal> ; és tedd .gitignore-ba (ZÁRÓ PERJEL NÉLKÜL)."
  exit 1
fi
# ⛔ FELOLDATLAN MERGE-KONFLIKTUS (2026-09-14, valós kár KÉTSZER). ~10 párhuzamos szál
# mellett a közös doksik (MEMORY.md, INDEX.md, DECISIONS.md) minden rebase-en ütköznek.
# A MEMORY.md-be landolt jelölőt a nap zárásakor észrevettük — az INDEX.md-ét viszont
# SENKI: a # bejegyzést tett olvashatatlanná. Egyetlen kapu sem nézte. Ez az.
# ⚠️ A STAGED tartalmat olvassa (`git show :<f>`), nem a munkafát: a kapuk a munkafán
# mérnek, és pont ez engedett már át egy féloldalas commitot.
# ⛔ `if`, nem `grep -q … && echo`: ez a fájl `set -e` alatt fut, és a `&&` a NEM-TALÁLAT
# ágon 1-et ad — ami a ciklus utolsó parancsaként az egész értékadást bukóvá teszi, tehát
# a hook NÉMÁN, üzenet nélkül meghalna MINDEN commiton. (Mérve: pontosan ez történt, és az
# öntesztem azért volt zöld, mert `set -e` nélkül futtattam — az őr nem a saját környezetében.)
conf=$(git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
  if git show ":$f" 2>/dev/null | grep -qE '^(<{7}|={7}|>{7})( |$)'; then echo "$f"; fi
done)
if [ -n "$conf" ]; then
  echo "⛔ FELOLDATLAN MERGE-KONFLIKTUS a commitba szánt tartalomban:"
  echo "$conf" | sed 's/^/   · /'
  echo "   Oldd fel a <<<<<<< / ======= / >>>>>>> blokkokat, aztán git add újra."
  exit 1
fi
# ⛔ A KÖZÖS DOKSIK GENERÁLT INDEXE (2026-09-23). Az ADR-ek a `_planning/decisions/` alatt
# fájlonként élnek; a `DECISIONS.md` és a memória `INDEX.md` GENERÁLT. Ez a kapu bukik, ha a két
# index elavult vagy kézzel szerkesztett, ha egy ADR-fájl neve és fejléce eltér — és ha két ADR
# ugyanazt a számot viseli. ⚠️ Ez utóbbi a lényeg: külön fájlok között a git SEMMILYEN ütközést
# nem jelez, tehát a duplikátum-ellenőrzés nélkül a darabolás NÉMA beolvadást gyártana (így
# olvadt be a két ADR-0033). Commit módban a STAGED tartalmat méri.
if [ -f scripts/planning-index.mts ] && \
   changed_files | grep -qE '^_planning/(DECISIONS\.md|decisions/|memory/)|^scripts/(planning-index\.mts|land-rebase\.sh)'; then
  echo "[pre-commit] planning-index (friss-e a két generált index, nincs-e duplikált ADR-szám)…"
  if [ -n "${LAND_RANGE:-}" ]; then
    npx tsx scripts/planning-index.mts check --no-placeholder >"$GATE_LOG" || gate_failed
  else
    npx tsx scripts/planning-index.mts check --staged >"$GATE_LOG" || gate_failed
  fi
fi
# A feloldó MAGA is kapu alatt: eldobható git-repóban a valódi `land-rebase.sh` fut (párhuzamos
# ADR · duplikátum · régi alakú szerkesztés átvétele · idegen ütközés · negatív kontroll).
# ~75 s, ezért csak akkor fut, ha a land/feloldó útja változik.
if [ -f scripts/planning-index-land-check.mts ] && \
   changed_files | grep -qE '^scripts/(planning-index\.mts|planning-index-land-check\.mts|land-rebase\.sh|land\.sh)$'; then
  echo "[pre-commit] planning-index-land-check (a land feloldja-e a generált indexeket, és CSAK azokat)…"
  npx tsx scripts/planning-index-land-check.mts >"$GATE_LOG" || gate_failed
fi
# ⛔ FELÜLET-KAPU strukturális iker (§2b, ADR-0066/0076). The runtime PreToolUse hook
# (surface-plan-scan.mjs) blocks surface EDITS; this blocks the COMMIT boundary — a
# rendered surface cannot land without an approval/exception token on the branch. Commit
# mode only: at land time (LAND_RANGE) the token is long gone and the work was gated when
# it was committed, so re-checking here would falsely block a clean land.
if [ -z "${LAND_RANGE:-}" ] && [ -f scripts/surface-gate-check.mjs ]; then
  echo "[pre-commit] felület-kapu (§2b terv-jóváhagyás)…"
  git diff --cached --name-only | node scripts/surface-gate-check.mjs
fi
echo "[pre-commit] i18n-lint (§B.18)…"
npx tsx scripts/i18n-lint.mts
echo "[pre-commit] i18n-katalógus frissesség…"
npx tsx scripts/extract-i18n.mts --check
# ADR-0067 ②: the STRUCTURAL check. i18n-lint hunts Hungarian ACCENTS and is blind
# to unaccented Hungarian ("1 db" shipped to a Polish tenant exactly that way); this
# renders the real surfaces in a marked pseudo-locale, where anything unmarked never
# went through T() — accents or not.
if [ -f scripts/i18n-pseudo-check.mts ]; then
  echo "[pre-commit] i18n-pszeudo-nyelv (strukturális)…"
  npx tsx scripts/i18n-pseudo-check.mts
fi
# ADR-0063 + jóváhagyott terv (2026-08-29): a nyelvváltó nem attól van, hogy benne
# van a HTML-ben — a LÁTOGATÓNAK LÁTNIA kell. Böngészőben mér, mind a 16 sablonon,
# mindkét nézetben; piros önteszttel (a --self-test a hibát ELŐÁLLÍTJA és elvárja).
if [ -f scripts/lang-switcher-visibility-check.mts ] && \
   changed_files | grep -qE '^src/tenant/multilangCore\.ts|^src/engine/templates/|^src/ui/flags\.ts|^scripts/lang-switcher-visibility-check'; then
  echo "[pre-commit] lang-switcher-visibility (a nyelvváltó LÁTSZIK-e)…"
  npx tsx scripts/lang-switcher-visibility-check.mts
fi
# ADR-0117 ⑥ (Elek FK-007): a fedés-választó ZÁRÓ GOMBJA a hajtás alá esett — a modál
# renderelt, a DOM-ban benne volt a gomb, az isVisible() igazat mondott, és a tulaj
# mégsem tudta befejezni a döntést. Csak GEOMETRIAI ítélet fogja meg (elementFromPoint),
# és épp ezt nem tudja sem az Elek-DSL, sem a teljes-lapos screenshot. Piros önteszttel.
if [ -f scripts/overlap-modal-reach-check.mts ] && \
   changed_files | grep -qE '^src/server/bookingViews\.ts|^scripts/overlap-modal-reach-check'; then
  echo "[pre-commit] overlap-modal-reach (a záró gomb LÁTSZIK-e)…"
  npx tsx scripts/overlap-modal-reach-check.mts
fi
# Elek FK-007 E3: a `bookingViews.ts` kommentje „No native confirm()"-ot állított, közben
# a LEMONDÁS ágon natív `confirm()` futott — a tulajdonosi lemondás négy lépés volt, és a
# kód hazudott magáról. A komment nem kapu: ha nincs mérés, a következő szerkesztés
# visszateheti. Az őr a RENDERELT lapon méri (natív dialógus sehol · egy koppintás ·
# a modál MEGNEVEZ · a záró gomb elérhető és tényleg beküld · no-JS ág ép). Piros önteszttel.
if [ -f scripts/cancel-confirm-check.mts ] && \
   changed_files | grep -qE '^src/server/bookingViews\.ts|^scripts/cancel-confirm-check'; then
  echo "[pre-commit] cancel-confirm (a lemondás megerősítése a RENDSZERÉ)…"
  npx tsx scripts/cancel-confirm-check.mts >"$GATE_LOG" || gate_failed
fi
# ⛔⛔ ADATVESZTÉS-KOCKÁZAT (mérve 2026-09-14, tulajdonosi kiemelés): a konzol „jóváhagyott
# mock törlése" `confirm()`-ja `jsStr()` nélkül kapta a szöveget. A MAGYAR forrásban nincs
# aposztróf, a FORDÍTÁSBAN van (en: „hasn't", it: „l'operazione") → a kezelő SyntaxError lett,
# a confirm() SOHA nem futott le, és a visszafordíthatatlan törlés MEGERŐSÍTÉS NÉLKÜL ment el.
# Az őr MINDEN nyelvi csomagon + egy ellenséges ál-csomagon, a RENDERELT lapon, valódi
# böngészőben méri, hogy a kérdés tényleg lefut-e. Piros önteszttel (9 bukás, megnevezett
# nyelveken). ⚠️ DB-t igényel (a csomagok ott élnek).
if [ -f scripts/dialog-fires-check.mts ] && \
   changed_files | grep -qE '^(src/console/(views|partnerViews)\.ts|scripts/dialog-fires-check\.mts)'; then
  echo "[pre-commit] dialog-fires (lefut-e a megerősítés MINDEN nyelven)…"
  npx tsx scripts/dialog-fires-check.mts >"$GATE_LOG" || gate_failed
fi
# Elek FK-001 (E1/Z1/Z2): a lista SORA mondja meg, miről szól. 18 közel azonos
# számla-sor tétel-név nélkül · e-mail és SMS ugyanazzal az ikonnal · felfüggesztés-
# értesítő a visszakapcsolás ALATT, jelöletlenül. Mindhárom úgy nézett ki, hogy
# minden egység-teszt zöld: az ADAT megvolt, csak nem jutott el a sorig — ezért az
# őr a RENDERELT listát méri. Piros önteszttel (7 sértés a visszarontott nézeten).
if [ -f scripts/admin-list-labels-check.mts ] && \
   changed_files | grep -qE '^(src/server/adminViews\.ts|src/billing/invoiceItem\.ts|src/tenant/(messages|messageThreads|messagePreview|documents)\.ts)|^scripts/admin-list-labels-check'; then
  echo "[pre-commit] admin-list-labels (tétel-név · csatorna · túlhaladottság)…"
  npx tsx scripts/admin-list-labels-check.mts
fi
# A modul, amiért FIZET, de a vendégnek semmit nem mutat. Mérve a tulaj saját tenantján:
# 14 775 Ft-ért vett három modult, kettő üresen maradt, ezért az ÉLŐ lapról teljesen
# hiányzott — és egyetlen képernyő sem szólt róla. Az őr KÉT szinten mér: a predikátumon
# (a hamis riasztás ugyanolyan kár — négy modul üresen is renderel valamit, azokat
# dunningolni hazugság lenne) és a RENDERELT soron (név · ár a fiók ütemében · a tétel ·
# a teendő-mondat · élő href). Piros önteszttel (20 sértés a visszarontott lapon).
if [ -f scripts/paid-empty-check.mts ] && \
   changed_files | grep -qE '^(src/server/adminViews\.ts|src/server/public\.ts|src/tenant/(modules|editor)\.ts|src/modules\.ts)|^scripts/paid-empty-check'; then
  echo "[pre-commit] paid-empty (kifizetett, de üres modul)…"
  npx tsx scripts/paid-empty-check.mts
fi
# A ház-szintű Felszereltség PONTOSAN az, amit a tulaj kiválasztott (ADR-0209). A renderelő
# korábban kihúzta belőle, ami egy szobánál is szerepelt: aki mindkét helyen bejelölte,
