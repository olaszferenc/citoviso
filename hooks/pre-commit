# törli alóla — CASCADE), és ne hagyjon hátra sajátot (1 046 árva futás volt a parkban, 6 kapuból).
# A szülőt a scripts/lib/fixture-parent.mts adja, exit-hook törléssel. Forrás-szabály minden kapun +
# viselkedés (exit(1) után is törlődik) + park-cenzus (halott pid-ű címkék söprése). ⚠️ DB-t igényel.
if [ -f scripts/fixture-parent-check.mts ] && \
   changed_files | grep -qE '^scripts/[^/]+-check\.mts$|^scripts/lib/fixture-parent\.mts$'; then
  echo "[pre-commit] fixture-parent-check (kölcsönzött vagy hátrahagyott scrape_run egyetlen kapuban sem)…"
  npx tsx scripts/fixture-parent-check.mts >"$GATE_LOG" || gate_failed
fi
# ⭐⭐ A META-ŐR — MINDIG FUT, és nincs diff-scope-ja. Ez szándékos: egy új árva őr úgy
# keletkezik, hogy valaki LÉTREHOZ egy `scripts/*-check.mts`-t és ezt a fájlt nem nyitja
# meg — vagyis pont akkor, amikor semmilyen hook-fájlra szűkített trigger nem tüzelne.
# Fájlokat olvas, nem indít se böngészőt, se DB-t (~3 s).
if [ -f scripts/guard-wiring-check.mts ]; then
  echo "[pre-commit] guard-wiring-check (minden őr be van-e kötve)…"
  npx tsx scripts/guard-wiring-check.mts >"$GATE_LOG" || gate_failed
fi
# ⭐⭐ A MÁSODIK META-ŐR (ADR-0171) — „ha egy kapu elbukik, elolvasható-e, MIÉRT?"
# A `guard-wiring-check` azt őrzi, hogy az őr MEGHÍVÓDIK; ez azt, hogy a BUKÁSA OLVASHATÓ.
# A kettő együtt zárja a kört: egy meghívott őr, aminek a bukása néma, majdnem olyan
# használhatatlan, mint egy meg sem hívott — csak drágább, mert azt hiszed, védve vagy.
# ⚠️ MINDIG FUT, diff-scope NÉLKÜL, szándékosan: a visszaesés úgy keletkezik, hogy valaki egy
# ÚJ kapu-sort ír `>/dev/null`-lal, és az a sor egy MÁSIK szál rebase-én is bejöhet — egy
# hook-fájlra szűkített trigger ilyenkor nem tüzel megbízhatóan.
# Fájlt olvas + egy apró bash-harness, se böngésző, se DB (~2 s).
if [ -f scripts/gate-output-check.mts ]; then
  echo "[pre-commit] gate-output-check (a bukó kapu kimenete eljut-e az operátorhoz)…"
  npx tsx scripts/gate-output-check.mts >"$GATE_LOG" || gate_failed
fi
# ⏱️ A PÁRHUZAMOS FUTTATÓ SAJÁT ŐRE. A hook eleji mechanikát (feljegyzés → futtató)
# Író-sáv (a döntés ADR-je a scripts/gate-lane-check.mts fejlécében): a jelölés (`// gate-lane: own-fixture-only`) egy ÍGÉRET — a jelölt író
# kapuk a ② fázisban EGYMÁSSAL párhuzamosan futnak. Ez az őr a jelölt kapuk forrásán méri a
# szerkezeti osztályt (szűretlen selectFrom/deleteFrom/updateTable, nyers count(*), LIKE-takarítás,
# fix port, fix /tmp·assets/Temp, fix nevű scratch-DB, globális söprő hívás, közös outbox/,
# kölcsönzött sor). MINDIG fut (szöveg-őr, ~1 s): egy jelölt kapu bármely szerkesztése átmegy
# rajta. A saját változásakor a piros önteszt is (18 sértés + tiszta fixture + negatív kontroll).
if [ -f scripts/gate-lane-check.mts ]; then
  if changed_files | grep -qE '^scripts/(gate-lane-check\.mts|lib/gate-runner\.mjs)$'; then
    echo "[pre-commit] gate-lane-check --self-test (az író-sáv őre változott — pirosra tud-e menni)…"
    npx tsx scripts/gate-lane-check.mts --self-test >"$GATE_LOG" || gate_failed
  fi
  echo "[pre-commit] gate-lane-check (a jelölt író kapuk tartják-e az „own-fixture-only” ígéretet)…"
  npx tsx scripts/gate-lane-check.mts >"$GATE_LOG" || gate_failed
fi
# a hookból KIVÁGVA, a valódi futtatóval, fixture-kapukon méri: minden kapu lefut · `VAR=x`
# előtag és pipe-olt stdin eljut · a bukás kódja és kimenete kiíródik · az 1. fázis DB-je
# csak-olvasó, az írni próbáló (a hibát lenyelő) kapu normál módban újrafut · egy szkript nem
# fut önmagával párhuzamosan · gate_flush nélkül nincs zöld. Piros önteszttel (5 visszarontás).
# ⚠️ DB-t igényel (az író-fixture egy visszagörgetett tranzakcióban próbál írni).
if [ -f scripts/gate-runner-check.mts ] && \
   changed_files | grep -qE '^hooks/pre-commit$|^scripts/(lib/gate-runner\.mjs|lib/gate-ro-preload\.mjs|gate-runner-check\.mts)$'; then
  echo "[pre-commit] gate-runner-check (a párhuzamos futtató tartja-e a soros hook szerződését)…"
  npx tsx scripts/gate-runner-check.mts >"$GATE_LOG" || gate_failed
fi
# Every gate above was only RECORDED in parallel mode — here they run (see the header).
gate_flush
echo "[pre-commit] ✅ minden kapu zöld"
