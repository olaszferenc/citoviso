[Unit]
# Heti programajánló — az ÉPPEN VÁSÁROLT tenant köre (tulajdonosi döntés, 2026-09-23:
# „különben dühös lesz a tenant"). Ötpercenként megnézi, van-e poi-s tenant, akinek a
# saját települése még SOSEM volt begyűjtve (bármelyik aktiválási úton jött), és ha van,
# begyűjti a körét + újrarendereli az oldalát. Levelet nem küld. Ha senki nem vár: egy
# DB-lekérdezés, nulla költés. Advisory lock: a napi futással sosem fizet duplán.
Description=Citoviso programajánló — függő (újonnan vásárolt) tenantok gyűjtése
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=citoviso
WorkingDirectory=/opt/citoviso/app
ExecStart=/usr/bin/npx tsx scripts/gather-events.mts --pending
TimeoutStartSec=10800
StandardOutput=journal
StandardError=inherit
