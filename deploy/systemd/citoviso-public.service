[Unit]
Description=Citoviso public server (:4800)
After=network.target postgresql.service
Wants=postgresql.service
OnFailure=citoviso-alert@%n.service

[Service]
Type=simple
User=citoviso
WorkingDirectory=/home/citoviso/citoviso
ExecStart=/home/citoviso/citoviso/node_modules/.bin/tsx src/server/public.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
