[Unit]
Description=Citoviso operator console (:4600, internal)
After=network.target postgresql.service
Wants=postgresql.service
OnFailure=citoviso-alert@%n.service

[Service]
Type=simple
User=citoviso
WorkingDirectory=/home/citoviso/citoviso
ExecStart=/home/citoviso/citoviso/node_modules/.bin/tsx src/console/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
