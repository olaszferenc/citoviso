[Unit]
# ADR-0500 (tulaj „Mehet”, 2026-11-27): a jóváhagyási lánc utánpótlása — a régi generátoros mock
# újragenerálása a saját szövegéből, a sor nélküli kész mock sorba tétele, a render-kapun bukott terv
# automata újrapróbája. Semmit nem küld ki; a tulaj lapjáig visz. Leállítás: CHAIN_SUPPLY=off a .env-ben.
Description=Citoviso lánc-utánpótlás (ADR-0500)
After=network-online.target
Wants=network-online.target
OnFailure=citoviso-alert@%n.service

[Service]
Type=oneshot
User=citoviso
WorkingDirectory=/home/citoviso/citoviso
ExecStart=/home/citoviso/citoviso/node_modules/.bin/tsx scripts/chain-supply.mts tick
TimeoutStartSec=600
# A kiküldő (20), a konzol és a felderítő előbb kap processzort: ez csak a maradékot kapja.
CPUWeight=10
Nice=15
IOWeight=10
StandardOutput=append:/home/citoviso/.claude/citoviso-chain-supply.log
StandardError=inherit
