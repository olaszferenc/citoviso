[Unit]
# ADR-XXXX: viselkedés-üzenet (A változat) — leadenként EGY automatikus üzenet, ha a lead
# visszajön a tervére, megnézi az árat vagy megnyomja a próba-gombot. Idempotens: a
# behavior_message egyedi kulcsai (lead, cím) miatt egy leadnek / címnek egyszer megy ki.
# A konzol főkapcsolója (CRM → Viselkedés-üzenetek) alapból KI: addig a futás semmit nem küld.
Description=Citoviso viselkedés-üzenet tick (ADR-XXXX)
After=network-online.target
Wants=network-online.target
# ADR-0276: ha elhasal, a ház levelet kap (citoviso-alert@.service → alert_email).
OnFailure=citoviso-alert@%n.service

[Service]
Type=oneshot
User=citoviso
# A FŐ FÁBÓL fut, nem worktree-ből: a worktree-k jönnek-mennek (ADR-0052 integrációs pont).
WorkingDirectory=/home/citoviso/citoviso
ExecStart=/home/citoviso/citoviso/node_modules/.bin/tsx scripts/behavior-message.mts
TimeoutStartSec=600
StandardOutput=append:/home/citoviso/.claude/citoviso-behavior-message.log
StandardError=inherit
