[Unit]
Description=Citoviso public server (:4800)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=citoviso
WorkingDirectory=/opt/citoviso/app
ExecStart=/usr/bin/npx tsx src/server/public.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
