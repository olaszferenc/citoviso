[Unit]
Description=Citoviso válasz-gyűjtő (email) 120 mp-enként (ADR-0339)

[Timer]
# ⛔ Csak akkor engedélyezd, ha a végpont az SMS_RELAY_URL hostján már létezik (élesen: a
# nagy deploy után) — addig minden kör HTTP 404-et kap (a gyűjtő ezt csak naplózza).
OnBootSec=150
OnUnitActiveSec=120
AccuracySec=10s

[Install]
WantedBy=timers.target
