[Unit]
# ADR-0405: az automata megkeresés-kiküldő (tulaj, 2026-10-26). Egy futás = legfeljebb EGY lead
# az outreach_dispatch sorból, a konzol send-all útján (minden kapu újrafut). A főkapcsoló
# (app_setting outreach_auto) alapból KI; az ablakot (hétköznap 9–16 Budapest) és a napi
# plafont a KÓD tartja.
Description=Citoviso automata megkeresés-kiküldő tick (ADR-0405)
After=network-online.target
Wants=network-online.target
# ADR-0276: ha elhasal, a ház levelet kap (citoviso-alert@.service → alert_email).
OnFailure=citoviso-alert@%n.service

[Service]
Type=oneshot
User=citoviso
# A FŐ FÁBÓL fut, nem worktree-ből: a worktree-k jönnek-mennek (ADR-0052 integrációs pont).
WorkingDirectory=/home/citoviso/citoviso
ExecStart=/home/citoviso/citoviso/node_modules/.bin/tsx scripts/outreach-dispatch.mts tick
TimeoutStartSec=600
StandardOutput=append:/home/citoviso/.claude/citoviso-outreach-dispatch.log
StandardError=inherit
