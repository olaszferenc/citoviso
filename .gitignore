# dependencies & build
node_modules/
dist/
*.tsbuildinfo

# env & secrets (never commit)
.env
.env.*
!.env.example
security/
*.secret
*.secret.*

# generated tenant output & scratch
out/
tmp/
*.log

# scraper output (generated lead lists)
leads-*.json

# generator output (generated mock pages + previews)
mock-*.html
mock-preview*.png

# kb-shot verification artifacts (the committed captures live under kb/entries/)
kb-shot-*.png

# provisioned tenant sites (data plane — per-tenant snapshots, not source)
# Both spellings on purpose: in a worktree `sites` is a SYMLINK into the main tree,
# and a trailing-slash pattern never matches a symlink (git sees a file, not a dir).
# That exact gap once let a per-worktree symlink land and clobber a real directory.
sites
sites/

# local dev screenshot helper (hardcodes a local chromium path)
shot.mjs

# ontology distiller runtime artifacts (review docs are human-read then applied)
_planning/DOMAIN/_inbox/.work/
_planning/DOMAIN/_inbox/*.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local dev postgres cluster (embedded, never commit)
.pgdata/

# rendered flowchart images (regenerable from the .mmd.md sources; .md renders on GitHub)
_planning/*.png

# Design reference corpus — large, reproducible (zip from the user / uploads)
assets/szallas-mockok-180.zip
assets/_mock_extract/
assets/design-refs/types/

# Local email adapter test artifacts (ADR-0022)
outbox/

# Local SMS adapter test artifacts (ADR-0080)
outbox-sms/
outbox-mms/

# owner scratch drop folder (screenshots, samples — never committed)
assets/Temp
assets/Temp/

# Local backups (DB dumps) must never reach the remote repo
_backups/

# Purge/restore snapshots — contain lead PII, never commit
_planning/backups/

# Claude Design szinkron-munkamappa (citui.css másolat + vendorolt betűk) — nem repó-tartalom
.design-sync/

# §2b terv-vázlatok (mock fájlok) — jóváhagyás után fagynak be a design-refs/console alá
assets/design-refs/_drafts/
